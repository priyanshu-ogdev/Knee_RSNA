 "cells": [
  {
   "cell_type": "markdown",
   "id": "1",
   "metadata": {},
   "source": [
    "# RSNA 2026: End-to-End SOTA Inference\n",
    "\n",
    "**Architecture:** DINOv2 3D Transformer Ensemble (5-Fold)\\n\n",
    "**Hardware Target:** Kaggle Dual Tesla T4 (2x 16GB)\\n\n",
    "**Optimizations:** Batch=8 DataParallel, 4-Pass TTA, Native Sigmoid Calibration\n",
    "\n",
    "---\n",
    "\n",
    "### ⚠️ OFFLINE KAGGLE SUBMISSION REQUIREMENTS\n",
    "Because Kaggle requires **Internet Disabled** for submissions, you must upload TWO custom datasets to Kaggle:\n",
    "1.  **`rsna-knee-models`**: A dataset containing your entire GitHub repository + the `pipeline_out/` folder containing your trained weights.\n",
    "2.  **`rsna-wheels`**: A dataset containing the `.whl` files for `dicomsdl`, `timm`, and any other packages not natively in the Kaggle image. You must download these wheels locally via `pip download dicomsdl timm` and upload them."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. OFFLINE PIP INSTALLATION (Replace with your actual wheel dataset path)\n",
    "!pip install /kaggle/input/rsna-wheels/dicomsdl*.whl --no-index --find-links /kaggle/input/rsna-wheels/\n",
    "!pip install /kaggle/input/rsna-wheels/timm*.whl --no-index --find-links /kaggle/input/rsna-wheels/"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import torch\n",
    "import pandas as pd\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 2. KAGGLE ENVIRONMENT PATHS\n",
    "DATA_ROOT = \"/kaggle/input/rsna-knee-abnormality-detection\"\n",
    "TEST_CSV = os.path.join(DATA_ROOT, \"test.csv\")\n",
    "\n",
    "# Point this to the dataset where you uploaded your repository and weights\n",
    "REPO_ROOT = \"/kaggle/input/rsna-knee-models\"\n",
    "WEIGHTS_DIR = os.path.join(REPO_ROOT, \"pipeline_out\")\n",
    "\n",
    "# 3. INJECT REPOSITORY INTO PYTHON PATH\n",
    "if REPO_ROOT not in sys.path:\n",
    "    sys.path.insert(0, REPO_ROOT)\n",
    "\n",
    "# Now we can import the heavily optimized inference engine!\n",
    "from src.inference.inference import run_inference\n",
    "from src.modeling import model\n",
    "import src.core.config as config"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. LOAD THE 5-FOLD ENSEMBLE\n",
    "cfg = config.get_cfg(\"v2\")\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "models = []\n",
    "\n",
    "print(\"Loading 5-Fold DINOv2 Ensemble...\")\n",
    "for fold in range(5):\n",
    "    ckpt_path = os.path.join(WEIGHTS_DIR, f\"models_fold{fold}\", \"best.pt\")\n",
    "    if not os.path.exists(ckpt_path):\n",
    "        print(f\"[WARNING] Missing fold {fold} weights at {ckpt_path}\")\n",
    "        continue\n",
    "        \n",
    "    # Initialize backbone\n",
    "    m = model.build_model(cfg)\n",
    "    \n",
    "    # Load weights safely to CPU first\n",
    "    state_dict = torch.load(ckpt_path, map_location=\"cpu\")\n",
    "    if \"model\" in state_dict:\n",
    "        state_dict = state_dict[\"model\"]\n",
    "        \n",
    "    m.load_state_dict(state_dict)\n",
    "    \n",
    "    # Note: inference.py will automatically cast to DataParallel and move to GPU\n",
    "    m.eval()\n",
    "    models.append(m)\n",
    "\n",
    "print(f\"[SUCCESS] Loaded {len(models)} models into the ensemble.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. EXECUTE OPTIMIZED INFERENCE\n",
    "print(\"Starting Inference on Dual-T4 Kaggle GPUs...\")\n",
    "\n",
    "sub, stats = run_inference(\n",
    "    root=DATA_ROOT,\n",
    "    models=models,\n",
    "    test_csv=TEST_CSV,\n",
    "    cfg=cfg,\n",
    "    out_csv=\"/kaggle/working/submission.csv\",\n",
    "    cache_dir=\"/kaggle/working/cache\", # Use Kaggle's fast local scratch disk\n",
    "    workers=4,                         # Kaggle T4 kernels have 4 vCPUs\n",
    "    chunk=64,\n",
    "    device=device,\n",
    "    use_tta=True,                      # Active: 4-Pass TTA (+0.005 AUC)\n",
    "    n_tta=4,\n",
    "    batch=8                            # Active: Dual-T4 Saturation (4 per GPU)\n",
    ")\n",
    "\n",
    "print(\"\\n====================================\")\n",
    "print(\"[SUCCESS] KAGGLE SUBMISSION GENERATED\")\n",
    "print(\"====================================\")\n",
    "print(\"Cache Engine Stats:\", stats)\n",
    "display(sub.head())"
   ]
  }
 ],
